# Feature 9 test: interface runtime checking
println, "=== 9. interface 运行时检查 ==="

interface, Drawable
    fn, draw(self)
/end

class, Circle, implements, Drawable
    fn, __init__(r)
        set, self.r = r
    /end
    fn, draw(self)
        return, "drawing circle"
    /end
/end

# This should pass — Circle implements draw
set, c = Circle(5)
println, c.draw()
println, "Circle OK"

# This should fail — Point does not implement draw
class, Point, implements, Drawable
    fn, __init__(x, y)
        set, self.x = x
        set, self.y = y
    /end
    fn, coords(self)
        return, "(" + str(self.x) + "," + str(self.y) + ")"
    /end
/end

# Uncommenting the next line should raise a runtime error:
# set, p = Point(1, 2)
