paste, "=== Generator Tests ===\n"
fn, counter()
    yield, 1
    yield, 2
    yield, 3
/end
set, c, counter()
paste, "values: "
set, i, 0
while, i < 5
    set, v, resume(c)
    paste, v
    paste, " "
    set, i, i + 1
    if, i >= 3
        break
    /end
/end
paste, "\n"
fn, fib_gen()
    set, a, 0
    set, b, 1
    while, b < 100
        yield, b
        set, tmp, a + b
        set, a, b
        set, b, tmp
    /end
/end
set, fg, fib_gen()
paste, "fib: "
set, j, 0
while, j < 8
    set, f, resume(fg)
    paste, f
    paste, " "
    set, j, j + 1
/end
paste, "\n"
