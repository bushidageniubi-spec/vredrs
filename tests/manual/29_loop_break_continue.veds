fn, main(): int
    set, sum, 0
    set, i, 0
    while, i < 10
        set, i, i + 1
        if, i == 3
            continue
        /end
        if, i == 7
            break
        /end
        set, sum, sum + i
    /end
    assert, sum == 18
    println, "loop break/continue OK"
    return, 0
/end
