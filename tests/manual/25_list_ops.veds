fn, main(): int
    set, xs, [5, 3, 8, 1, 9, 2, 7]
    assert, xs# == 7
    set, total, 0
    set, i, 0
    while, i < xs#
        set, total, total + xs[i]
        set, i, i + 1
    /end
    assert, total == 35
    set, mx, xs[0]
    set, i, 1
    while, i < xs#
        if, xs[i] > mx
            set, mx, xs[i]
        /end
        set, i, i + 1
    /end
    assert, mx == 9
    println, "list ops OK"
    return, 0
/end
