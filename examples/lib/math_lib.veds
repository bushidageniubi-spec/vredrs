fn, factorial(n)
    if, n <= 1
        return, 1
    /end
    return, n * factorial(n - 1)
/end
fn, fibonacci(n)
    if, n < 2
        return, n
    /end
    return, fibonacci(n - 1) + fibonacci(n - 2)
/end
fn, is_prime(n)
    if, n < 2
        return, false
    /end
    set, i, 2
    while, i * i <= n
        if, n % i == 0
            return, false
        /end
        set, i, i + 1
    /end
    return, true
/end
