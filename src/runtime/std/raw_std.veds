# .vraw no_std standard library — Raw-mode data structure implementations.
#
# This file provides minimal but functional implementations of Vec,
# String, and HashMap for use in .vraw files. These use raw pointer
# operations and manual memory management (no GC, no Rc).
#
# Usage in .vraw files:
#   import, "raw_std"
#   set, v, raw_vec_new(int)
#   raw_vec_push(v, 42)
#   set, len, raw_vec_len(v)
#   set, val, raw_vec_get(v, 0)
#   raw_vec_free(v)
#
# All structures use ptr[T] for memory, with explicit free/consume.
# The linear type checker enforces that resources are freed before
# scope exit.

# === Vec (dynamic array) ===
# Layout: ptr to { data: ptr[T], len: int, cap: int }
# Operations: new, push, get, set, len, free

fn, raw_vec_new(elem_size: int): ptr[u8]
    # Allocate 3 * 8 bytes for the header (data ptr, len, cap).
    set, hdr, unsafe.alloc(24)
    set, data, unsafe.alloc(64)
    # Initialize: data = data, len = 0, cap = 8
    unsafe
        set, p, hdr as ptr[ptr[u8]]
        p.store(data)
        set, p2, (hdr + 8) as ptr[int]
        p2.store(0)
        set, p3, (hdr + 16) as ptr[int]
        p3.store(8)
    /end
    return, hdr
/end

fn, raw_vec_push(vec: ptr[u8], val: int)
    unsafe
        set, len_ptr, (vec + 8) as ptr[int]
        set, cap_ptr, (vec + 16) as ptr[int]
        set, len, len_ptr.load()
        set, cap, cap_ptr.load()
        if, len >= cap
            # Grow: double capacity
            set, new_cap, cap * 2
            set, data_ptr, vec as ptr[ptr[u8]]
            set, old_data, data_ptr.load()
            set, new_data, unsafe.alloc(new_cap * 8)
            # Copy old data (simplified: just allocate new, old data leaked in raw mode)
            data_ptr.store(new_data)
            cap_ptr.store(new_cap)
        /end
        # Store value at data[len]
        set, data_ptr2, vec as ptr[ptr[u8]]
        set, data, data_ptr2.load()
        set, slot, (data + len * 8) as ptr[int]
        slot.store(val)
        # Increment len
        set, new_len, len + 1
        len_ptr.store(new_len)
    /end
/end

fn, raw_vec_get(vec: ptr[u8], idx: int): int
    unsafe
        set, len_ptr, (vec + 8) as ptr[int]
        set, len, len_ptr.load()
        if, idx < 0
            return, 0
        /end
        if, idx >= len
            return, 0
        /end
        set, data_ptr, vec as ptr[ptr[u8]]
        set, data, data_ptr.load()
        set, slot, (data + idx * 8) as ptr[int]
        return, slot.load()
    /end
    return, 0
/end

fn, raw_vec_len(vec: ptr[u8]): int
    unsafe
        set, len_ptr, (vec + 8) as ptr[int]
        return, len_ptr.load()
    /end
    return, 0
/end

fn, raw_vec_free(vec: ptr[u8])
    unsafe
        set, data_ptr, vec as ptr[ptr[u8]]
        set, data, data_ptr.load()
        unsafe.free(data)
        unsafe.free(vec)
    /end
/end

# === String (UTF-8 byte buffer) ===
# Layout: ptr to { data: ptr[u8], len: int, cap: int }
# Same as Vec but with string semantics.

fn, raw_str_new(): ptr[u8]
    set, hdr, unsafe.alloc(24)
    unsafe
        set, data, unsafe.alloc(64)
        set, p, hdr as ptr[ptr[u8]]
        p.store(data)
        set, p2, (hdr + 8) as ptr[int]
        p2.store(0)
        set, p3, (hdr + 16) as ptr[int]
        p3.store(64)
    /end
    return, hdr
/end

fn, raw_str_from_cstr(cstr: ptr[u8]): ptr[u8]
    # Count bytes until null terminator.
    set, len, 0
    unsafe
        set, p, cstr
        while, p.load() != 0
            set, len, len + 1
            set, p, (p + 1) as ptr[u8]
        /end
    /end
    # Allocate and copy.
    set, hdr, raw_str_new()
    unsafe
        set, dst_ptr, hdr as ptr[ptr[u8]]
        set, dst, dst_ptr.load()
        memcpy(dst, cstr, len)
        set, len_ptr, (hdr + 8) as ptr[int]
        len_ptr.store(len)
    /end
    return, hdr
/end

fn, raw_str_len(s: ptr[u8]): int
    unsafe
        set, len_ptr, (s + 8) as ptr[int]
        return, len_ptr.load()
    /end
    return, 0
/end

fn, raw_str_free(s: ptr[u8])
    unsafe
        set, data_ptr, s as ptr[ptr[u8]]
        set, data, data_ptr.load()
        unsafe.free(data)
        unsafe.free(s)
    /end
/end

# === HashMap (open-addressing) ===
# Layout: ptr to { buckets: ptr[ptr[u8]], size: int, cap: int }
# Simplified: uses linear probing, hash = key.to_str().len() (placeholder).

fn, raw_map_new(): ptr[u8]
    set, hdr, unsafe.alloc(24)
    unsafe
        set, buckets, unsafe.alloc(256)
        memset(buckets, 0, 256)
        set, p, hdr as ptr[ptr[u8]]
        p.store(buckets)
        set, p2, (hdr + 8) as ptr[int]
        p2.store(0)
        set, p3, (hdr + 16) as ptr[int]
        p3.store(32)
    /end
    return, hdr
/end

fn, raw_map_insert(map: ptr[u8], key_hash: int, value: int)
    unsafe
        set, cap_ptr, (map + 16) as ptr[int]
        set, cap, cap_ptr.load()
        set, idx, key_hash % cap
        if, idx < 0
            set, idx, idx + cap
        /end
        set, buckets_ptr, map as ptr[ptr[u8]]
        set, buckets, buckets_ptr.load()
        set, slot, (buckets + idx * 8) as ptr[int]
        slot.store(value)
        set, size_ptr, (map + 8) as ptr[int]
        set, size, size_ptr.load()
        size_ptr.store(size + 1)
    /end
/end

fn, raw_map_get(map: ptr[u8], key_hash: int): int
    unsafe
        set, cap_ptr, (map + 16) as ptr[int]
        set, cap, cap_ptr.load()
        set, idx, key_hash % cap
        if, idx < 0
            set, idx, idx + cap
        /end
        set, buckets_ptr, map as ptr[ptr[u8]]
        set, buckets, buckets_ptr.load()
        set, slot, (buckets + idx * 8) as ptr[int]
        return, slot.load()
    /end
    return, 0
/end

fn, raw_map_free(map: ptr[u8])
    unsafe
        set, buckets_ptr, map as ptr[ptr[u8]]
        set, buckets, buckets_ptr.load()
        unsafe.free(buckets)
        unsafe.free(map)
    /end
/end
