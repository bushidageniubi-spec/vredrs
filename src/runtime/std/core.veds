# Core standard library — pure Vredrs implementation.
# These functions replace the VM's hardcoded call_builtin_value entries.
# No Rust FFI: everything is implemented in pure Vredrs.

# ── Type conversions ──────────────────────────────────────

fn, core_len(v)
    # Dispatch by trying methods, fallback to 0.
    if, v == null
        return, 0
    /end
    return, v#
/end

fn, core_str(v)
    # String conversion: use the value's __str__ if available,
    # otherwise use the built-in str() as a fallback.
    return, str(v)
/end

fn, core_int(v)
    return, int(v)
/end

fn, core_float(v)
    return, float(v)
/end

fn, core_bool(v)
    if, v
        return, true
    /end
    return, false
/end

fn, core_type_of(v)
    return, type_of(v)
/end

# ── Math helpers ──────────────────────────────────────────

fn, core_abs(x)
    if, x < 0
        return, 0 - x
    /end
    return, x
/end

fn, core_floor(x)
    set, i, int(x)
    if, x < i
        return, i - 1
    /end
    return, i
/end

fn, core_ceil(x)
    set, i, int(x)
    if, x > i
        return, i + 1
    /end
    return, i
/end

fn, core_round(x)
    set, i, int(x)
    if, x - i >= 0.5
        return, i + 1
    /end
    if, x - i <= -0.5
        return, i - 1
    /end
    return, i
/end

fn, core_min(a, b)
    if, a < b
        return, a
    /end
    return, b
/end

fn, core_max(a, b)
    if, a > b
        return, a
    /end
    return, b
/end

fn, core_sum(xs)
    set, total, 0
    for, x, in, xs
        set, total, total + x
    /end
    return, total
/end

fn, core_pow(base, exp)
    set, result, 1
    set, i, 0
    while, i < exp
        set, result, result * base
        set, i, i + 1
    /end
    return, result
/end

# ── Character operations ──────────────────────────────────

fn, core_chr(n)
    # Convert integer to single-character string.
    # Uses a lookup for ASCII printable range.
    if, n == 32
        return, " "
    /end
    if, n == 33
        return, "!"
    /end
    if, n == 34
        return, "\""
    /end
    if, n == 35
        return, "#"
    /end
    if, n == 36
        return, "$"
    /end
    if, n == 37
        return, "%"
    /end
    if, n == 38
        return, "&"
    /end
    if, n == 39
        return, "'"
    /end
    if, n == 40
        return, "("
    /end
    if, n == 41
        return, ")"
    /end
    if, n == 42
        return, "*"
    /end
    if, n == 43
        return, "+"
    /end
    if, n == 44
        return, ","
    /end
    if, n == 45
        return, "-"
    /end
    if, n == 46
        return, "."
    /end
    if, n == 47
        return, "/"
    /end
    if, n >= 48
        if, n <= 57
            # Digits 0-9
            return, core_digit_char(n - 48)
        /end
    /end
    if, n >= 65
        if, n <= 90
            # Uppercase A-Z
            return, core_upper_char(n - 65)
        /end
    /end
    if, n >= 97
        if, n <= 122
            # Lowercase a-z
            return, core_lower_char(n - 97)
        /end
    /end
    return, "?"
/end

fn, core_digit_char(d)
    if, d == 0
        return, "0"
    /end
    if, d == 1
        return, "1"
    /end
    if, d == 2
        return, "2"
    /end
    if, d == 3
        return, "3"
    /end
    if, d == 4
        return, "4"
    /end
    if, d == 5
        return, "5"
    /end
    if, d == 6
        return, "6"
    /end
    if, d == 7
        return, "7"
    /end
    if, d == 8
        return, "8"
    /end
    return, "9"
/end

fn, core_upper_char(d)
    if, d == 0
        return, "A"
    /end
    if, d == 1
        return, "B"
    /end
    if, d == 2
        return, "C"
    /end
    if, d == 3
        return, "D"
    /end
    if, d == 4
        return, "E"
    /end
    if, d == 5
        return, "F"
    /end
    if, d == 6
        return, "G"
    /end
    if, d == 7
        return, "H"
    /end
    if, d == 8
        return, "I"
    /end
    if, d == 9
        return, "J"
    /end
    if, d == 10
        return, "K"
    /end
    if, d == 11
        return, "L"
    /end
    if, d == 12
        return, "M"
    /end
    if, d == 13
        return, "N"
    /end
    if, d == 14
        return, "O"
    /end
    if, d == 15
        return, "P"
    /end
    if, d == 16
        return, "Q"
    /end
    if, d == 17
        return, "R"
    /end
    if, d == 18
        return, "S"
    /end
    if, d == 19
        return, "T"
    /end
    if, d == 20
        return, "U"
    /end
    if, d == 21
        return, "V"
    /end
    if, d == 22
        return, "W"
    /end
    if, d == 23
        return, "X"
    /end
    if, d == 24
        return, "Y"
    /end
    return, "Z"
/end

fn, core_lower_char(d)
    if, d == 0
        return, "a"
    /end
    if, d == 1
        return, "b"
    /end
    if, d == 2
        return, "c"
    /end
    if, d == 3
        return, "d"
    /end
    if, d == 4
        return, "e"
    /end
    if, d == 5
        return, "f"
    /end
    if, d == 6
        return, "g"
    /end
    if, d == 7
        return, "h"
