/end

fn, core_ord(s)
    # Convert single-character string to integer (ASCII).
    if, s == " "
        return, 32
    /end
    if, s == "!"
        return, 33
    /end
    if, s == "\""
        return, 34
    /end
    if, s == "#"
        return, 35
    /end
    if, s == "$"
        return, 36
    /end
    if, s == "%"
        return, 37
    /end
