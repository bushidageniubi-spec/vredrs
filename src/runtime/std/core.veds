# ── List operations ───────────────────────────────────────

fn, core_concat(a, b)
    return, a + b
/end

fn, core_contains(xs, item)
    if, type_of(xs) == "str"
        if, core_index_of(xs, item) >= 0
            return, true
        /end
        return, false
    /end
    for, x, in, xs
        if, x == item
            return, true
        /end
    /end
    return, false
/end

fn, core_find(xs, item)
    set, i, 0
    for, x, in, xs
        if, x == item
            return, i
        /end
        set, i, i + 1
    /end
    return, -1
/end

fn, core_find_all(xs, item)
    set, result, []
    set, i, 0
    for, x, in, xs
        if, x == item
            set, result, result + [i]
        /end
        set, i, i + 1
    /end
    return, result
/end

fn, core_first(xs)
    for, x, in, xs
        return, x
    /end
    return, null
/end

fn, core_last(xs)
    set, result, null
    for, x, in, xs
        set, result, x
    /end
    return, result
/end

fn, core_enumerate(xs)
    set, result, []
    set, i, 0
    for, x, in, xs
        set, result, result + [[i, x]]
        set, i, i + 1
    /end
    return, result
/end

fn, core_zip(a, b)
    set, result, []
    set, i, 0
    while, i < a#
        if, i >= b#
            return, result
        /end
        set, result, result + [[a[i], b[i]]]
        set, i, i + 1
    /end
    return, result
/end

fn, core_map(f, xs)
    set, result, []
    for, x, in, xs
        set, result, result + [f(x)]
    /end
    return, result
/end

fn, core_filter(f, xs)
    set, result, []
    for, x, in, xs
        if, f(x)
            set, result, result + [x]
        /end
    /end
    return, result
/end

fn, core_reduce(f, xs, init)
    set, acc, init
    for, x, in, xs
        set, acc, f(acc, x)
    /end
    return, acc
/end

fn, core_reversed(xs)
    set, result, []
    set, i, xs# - 1
    while, i >= 0
        set, result, result + [xs[i]]
        set, i, i - 1
    /end
    return, result
/end

fn, core_sorted(xs)
    # Simple insertion sort (pure Vredrs, no FFI).
    set, result, []
    for, x, in, xs
        set, inserted, false
        set, j, 0
        while, j < result#
            if, x < result[j]
                set, result, result[0:j] + [x] + result[j:]
                set, inserted, true
                break
            /end
            set, j, j + 1
        /end
        if, not inserted
            set, result, result + [x]
        /end
    /end
    return, result
/end

fn, core_sorted_desc(xs)
    set, result, []
    for, x, in, xs
        set, inserted, false
        set, j, 0
        while, j < result#
            if, x > result[j]
                set, result, result[0:j] + [x] + result[j:]
                set, inserted, true
                break
            /end
            set, j, j + 1
        /end
        if, not inserted
            set, result, result + [x]
        /end
    /end
    return, result
/end

# ── String operations ─────────────────────────────────────

fn, core_split(s, sep)
    # Split string by separator.
    set, result, []
    if, sep == ""
        # Split into individual characters.
        set, i, 0
        while, i < s#
            set, result, result + [s[i:i+1]]
            set, i, i + 1
        /end
        return, result
    /end
    set, start, 0
    set, i, 0
    while, i <= s# - sep#
        if, s[i:i+sep#] == sep
            set, result, result + [s[start:i]]
            set, start, i + sep#
            set, i, i + sep#
        else
            set, i, i + 1
        /end
    /end
    set, result, result + [s[start:]]
    return, result
/end

fn, core_join(xs, sep)
    set, result, ""
    set, first, true
    for, x, in, xs
        if, first
            set, result, str(x)
            set, first, false
        else
            set, result, result + sep + str(x)
        /end
    /end
    return, result
/end

fn, core_replace(s, old_str, new_str)
    # Replace all occurrences of old with new in s.
    set, result, ""
    set, i, 0
    while, i < s#
        if, i <= s# - old#
            if, s[i:i+old_str#] == old
                set, result, result + new_str
                set, i, i + old_str#
            else
                set, result, result + s[i:i+1]
                set, i, i + 1
            /end
        else
            set, result, result + s[i:i+1]
            set, i, i + 1
        /end
    /end
    return, result
/end

fn, core_trim(s)
    # Trim whitespace from both ends.
    set, start, 0
    set, end, s#
    while, start < end
        set, c, s[start:start+1]
        if, c == " "
            set, start, start + 1
        elif, c == "\t"
            set, start, start + 1
        elif, c == "\n"
            set, start, start + 1
        elif, c == "\r"
            set, start, start + 1
        else
            break
        /end
    /end
    while, end > start
        set, c, s[end-1:end]
        if, c == " "
            set, end, end - 1
        elif, c == "\t"
            set, end, end - 1
        elif, c == "\n"
            set, end, end - 1
        elif, c == "\r"
            set, end, end - 1
        else
            break
        /end
    /end
    return, s[start:end]
/end

fn, core_upper(s)
    # Convert to uppercase.
    set, result, ""
    set, i, 0
    while, i < s#
        set, c, s[i:i+1]
        set, code, core_ord(c)
        if, code >= 97
            if, code <= 122
                set, result, result + core_chr(code - 32)
            else
                set, result, result + c
            /end
        else
            set, result, result + c
        /end
        set, i, i + 1
    /end
    return, result
/end

fn, core_lower(s)
    set, result, ""
    set, i, 0
    while, i < s#
        set, c, s[i:i+1]
        set, code, core_ord(c)
        if, code >= 65
            if, code <= 90
                set, result, result + core_chr(code + 32)
            else
                set, result, result + c
            /end
        else
            set, result, result + c
        /end
        set, i, i + 1
    /end
    return, result
/end

fn, core_starts_with(s, prefix)
    if, s# < prefix#
        return, false
    /end
    return, s[0:prefix#] == prefix
/end

fn, core_ends_with(s, suffix)
    if, s# < suffix#
        return, false
    /end
    return, s[s#-suffix#:] == suffix
/end

fn, core_index_of(s, sub)
    set, i, 0
    while, i <= s# - sub#
        if, s[i:i+sub#] == sub
            return, i
        /end
        set, i, i + 1
    /end
    return, -1
/end

fn, core_repeat(s, n)
    set, result, ""
    set, i, 0
    while, i < n
        set, result, result + s
        set, i, i + 1
    /end
    return, result
/end

fn, core_reverse(s)
    set, result, ""
    set, i, s# - 1
    while, i >= 0
        set, result, result + s[i:i+1]
        set, i, i - 1
    /end
    return, result
/end

# ── JSON (pure Vredrs) ────────────────────────────────────

fn, core_json_stringify(v)
    if, v == null
        return, "null"
    /end
    if, v == true
        return, "true"
    /end
    if, v == false
        return, "false"
    /end
    set, t, type_of(v)
    if, t == "int"
        return, str(v)
    /end
    if, t == "float"
        return, str(v)
    /end
    if, t == "str"
        return, "\"" + v + "\""
    /end
    if, t == "list"
        set, parts, []
        for, item, in, v
            set, parts, parts + [core_json_stringify(item)]
        /end
        return, "[" + core_join(parts, ",") + "]"
    /end
    if, t == "dict"
        set, parts, []
        set, ks, keys(v)
        for, k, in, ks
            set, parts, parts + ["\"" + k + "\":" + core_json_stringify(v[k])]
        /end
        return, "{" + core_join(parts, ",") + "}"
    /end
    return, "null"
/end

fn, core_json_parse(text)
    # Simplified JSON parser: handles objects, arrays, strings, numbers, bools, null.
    # This is a recursive descent parser in pure Vredrs.
    set, state, core_json_parser_new(text)
    return, core_json_parse_value(state)
/end

fn, core_json_parser_new(text)
    return, {"text": text, "pos": 0}
/end

fn, core_json_parse_value(state)
    core_json_skip_ws(state)
    set, c, core_json_peek(state)
    if, c == "{"
        return, core_json_parse_object(state)
    /end
    if, c == "["
        return, core_json_parse_array(state)
    /end
    if, c == "\""
        return, core_json_parse_string(state)
    /end
    if, c == "t"
        return, core_json_parse_true(state)
    /end
    if, c == "f"
        return, core_json_parse_false(state)
    /end
    if, c == "n"
        return, core_json_parse_null(state)
    /end
    return, core_json_parse_number(state)
/end

fn, core_json_peek(state)
    set, p, state["pos"]
    set, t, state["text"]
    if, p >= t#
        return, ""
    /end
    return, t[p:p+1]
/end

fn, core_json_skip_ws(state)
    set, t, state["text"]
    while, state["pos"] < t#
        set, c, t[state["pos"]:state["pos"]+1]
        if, c == " "
            state["pos"] = state["pos"] + 1
        /end
        if, c == "\t"
            state["pos"] = state["pos"] + 1
        /end
        if, c == "\n"
            state["pos"] = state["pos"] + 1
        /end
        if, c == "\r"
            state["pos"] = state["pos"] + 1
        else
            return
        /end
    /end
/end

fn, core_json_parse_string(state)
    set, t, state["text"]
    # Skip opening quote.
    state["pos"] = state["pos"] + 1
    set, result, ""
    while, state["pos"] < t#
        set, c, t[state["pos"]:state["pos"]+1]
        state["pos"] = state["pos"] + 1
        if, c == "\""
            return, result
        /end
        if, c == "\\"
            # Escape sequence.
            set, next, t[state["pos"]:state["pos"]+1]
            state["pos"] = state["pos"] + 1
            if, next == "n"
                set, result, result + "\n"
            elif, next == "t"
                set, result, result + "\t"
            elif, next == "r"
                set, result, result + "\r"
            elif, next == "\""
                set, result, result + "\""
            elif, next == "\\"
                set, result, result + "\\"
            else
                set, result, result + next
            /end
        else
            set, result, result + c
        /end
    /end
    return, result
/end

fn, core_json_parse_number(state)
    set, t, state["text"]
    set, start, state["pos"]
    while, state["pos"] < t#
        set, c, t[state["pos"]:state["pos"]+1]
        if, c == "0"
            state["pos"] = state["pos"] + 1
        elif, c == "1"
            state["pos"] = state["pos"] + 1
        elif, c == "2"
            state["pos"] = state["pos"] + 1
        elif, c == "3"
            state["pos"] = state["pos"] + 1
        elif, c == "4"
            state["pos"] = state["pos"] + 1
        elif, c == "5"
            state["pos"] = state["pos"] + 1
        elif, c == "6"
            state["pos"] = state["pos"] + 1
        elif, c == "7"
            state["pos"] = state["pos"] + 1
        elif, c == "8"
            state["pos"] = state["pos"] + 1
        elif, c == "9"
            state["pos"] = state["pos"] + 1
        elif, c == "."
            state["pos"] = state["pos"] + 1
        elif, c == "-"
            state["pos"] = state["pos"] + 1
        else
            break
        /end
    /end
    set, numstr, t[start:state["pos"]]
    if, core_index_of(numstr, ".") >= 0
        return, float(numstr)
    /end
    return, int(numstr)
/end

fn, core_json_parse_true(state)
    state["pos"] = state["pos"] + 4
    return, true
/end

fn, core_json_parse_false(state)
    state["pos"] = state["pos"] + 5
    return, false
/end

fn, core_json_parse_null(state)
    state["pos"] = state["pos"] + 4
    return, null
/end

fn, core_json_parse_array(state)
    set, t, state["text"]
    state["pos"] = state["pos"] + 1
    set, result, []
    core_json_skip_ws(state)
    if, core_json_peek(state) == "]"
        state["pos"] = state["pos"] + 1
        return, result
    /end
    while, state["pos"] < t#
        set, v, core_json_parse_value(state)
        set, result, result + [v]
        core_json_skip_ws(state)
        set, c, core_json_peek(state)
        if, c == ","
            state["pos"] = state["pos"] + 1
        elif, c == "]"
            state["pos"] = state["pos"] + 1
            return, result
        else
            return, result
        /end
    /end
    return, result
/end

fn, core_json_parse_object(state)
    set, t, state["text"]
    state["pos"] = state["pos"] + 1
    set, result, {}
    core_json_skip_ws(state)
    if, core_json_peek(state) == "}"
        state["pos"] = state["pos"] + 1
        return, result
    /end
    while, state["pos"] < t#
        core_json_skip_ws(state)
        set, k, core_json_parse_string(state)
        core_json_skip_ws(state)
        # Skip colon.
        state["pos"] = state["pos"] + 1
        set, v, core_json_parse_value(state)
        result[k] = v
        core_json_skip_ws(state)
        set, c, core_json_peek(state)
        if, c == ","
            state["pos"] = state["pos"] + 1
        elif, c == "}"
            state["pos"] = state["pos"] + 1
            return, result
        else
            return, result
        /end
    /end
    return, result
/end

# ── File I/O (pure Vredrs, using unsafe syscalls) ─────────
# These use the VM's built-in file operations as thin wrappers.
# The actual syscall implementations live in the VM runtime.

fn, core_file_exists(path)
    return, file_exists(path)
/end

fn, core_read_file(path)
    return, read_file(path)
/end

fn, core_write_file(path, content)
    return, write_file(path, content)
/end

# ── Result type ───────────────────────────────────────────

fn, core_Ok(v)
    return, {"ok": true, "value": v}
/end

fn, core_Err(e)
    return, {"ok": false, "error": e}
/end

fn, core_is_ok(r)
    return, r["ok"] == true
/end

fn, core_is_err(r)
    return, r["ok"] == false
/end

fn, core_unwrap(r)
    if, r["ok"]
        return, r["value"]
    /end
    return, null
/end

fn, core_unwrap_or(r, default)
    if, r["ok"]
        return, r["value"]
    /end
    return, default
/end
